              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.orderId) {",
                  "  pm.collectionVariables.set('orderId', body.data.orderId);",
                  "  const cs = body.data.creditScore || {};",
                  "  console.log('orderId ' + body.data.orderId + '  ' + body.data.risk.riskStatus);",
                  "  console.log('A-Card Limit ' + cs.creditLimit + '   MLCB max ' + cs.mlcbMaxLoanAmount);",
                  "}",
                  "if (body.code === '600' && /authoriz/i.test(body.msg || '')) {",
                  "  console.log('This user has not authorised MyInfo with Ascend. Send the whole myinfo object instead of userId.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/openApi/apply/credit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openApi",
                "apply",
                "credit"
              ]
