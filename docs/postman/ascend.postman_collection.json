        {
          "name": "1b. apply/credit — userId only (RETURNS 500)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('userId')) { throw new Error('Run 1a first — it captures a userId.'); }",
                  "pm.collectionVariables.set('dataJson', JSON.stringify({",
                  "  userId: pm.collectionVariables.get('userId'),",
