              "raw": "{\n  \"appId\": \"{{appId}}\",\n  \"timestamp\": \"{{timestamp}}\",\n  \"nonce\": \"{{nonce}}\",\n  \"sign\": \"{{sign}}\",\n  \"data\": {\n    \"desiredAmount\": \"{{desiredAmount}}\",\n    \"myinfo\": {\n      \"uinfin\": \"S1234567D\",\n      \"name\": \"PASTE A REAL MYINFO OBJECT HERE\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
