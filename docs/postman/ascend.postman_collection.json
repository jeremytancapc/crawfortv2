{
  "info": {
    "name": "Ascend Open API — diagnostics",
    "description": "Crawfort ↔ Ascend Open API.\n\nSet appSecret in the collection variables before running anything. The\npre-request script signs every call, so nothing has to be signed by hand -\nwhich matters, because the signature covers a timestamp Ascend rejects if it\nis more than five minutes off its own clock.\n\nVerified against the test environment on 2026-09-17:\n\n  users         works. Returns userId, newCustomer, hasMyinfo.\n  apply/credit  works ONLY with the full myinfo object. Sending userId alone\n                returns 500 even when users reported hasMyinfo true.\n  file/upload   returns 500: System error for every shape tried, with a valid\n                userId that already has a PENDING order.\n  order/query   404s on this environment.\n\nappId 10001 is the real credential, not the documentation's placeholder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-mms.newtime.top",
      "description": "test (default). uat: https://api-admin-uat-ascend.crawfort.com | prod: https://api-admin-ascend.crawfort.com"
    },
    {
      "key": "appId",
      "value": "",
      "description": "REQUIRED. Note: 10001 is the value in Ascend's own documentation example."
    },
    {
      "key": "appSecret",
      "value": "",
      "description": "REQUIRED."
    },
    {
      "key": "idNumber",
      "value": "S7790721A"
    },
    {
      "key": "phone",
      "value": "91234567"
    },
    {
      "key": "desiredAmount",
      "value": "5000"
    },
    {
      "key": "userId",
      "value": "",
      "description": "Captured automatically by 1a."
    },
    {
      "key": "orderId",
      "value": "",
      "description": "Captured automatically by 1b."
    },
    {
      "key": "dataJson",
      "value": ""
    },
    {
      "key": "timestamp",
      "value": ""
    },
    {
      "key": "nonce",
      "value": ""
    },
    {
      "key": "sign",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ascend request signing. Shared by every request in this collection,",
          "// so no request can be dismissed as 'signed differently'.",
          "//",
          "// HMAC-SHA256: `sign` excluded, empty values dropped, keys in ASCII",
          "// order, joined key=value with &. UPPERCASE hex - lowercase returns 600.",
          "// `data` participates as its JSON string.",
          "//",
          "// Each request signs freshly: `nonce` must be unique per request, and",
          "// reusing one returns 401, which reads like bad credentials and is not.",
          "",
          "const CryptoJS = require('crypto-js');",
          "",
          "const appId  = pm.collectionVariables.get('appId');",
          "const secret = pm.collectionVariables.get('appSecret');",
          "const data   = pm.collectionVariables.get('dataJson') || '';",
          "",
          "if (!appId || !secret) {",
          "  throw new Error('Set appId and appSecret in the collection variables first.');",
          "}",
          "",
          "const timestamp = String(Date.now());",
          "const nonce = 'pm-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);",
          "",
          "const params = { appId: appId, timestamp: timestamp, nonce: nonce, data: data };",
          "",
          "const signString = Object.keys(params)",
          "  .filter(function (k) { return k !== 'sign'; })",
          "  .filter(function (k) { return params[k] !== undefined && params[k] !== null && params[k] !== ''; })",
          "  .sort()",
          "  .map(function (k) { return k + '=' + params[k]; })",
          "  .join('&');",
          "",
          "pm.collectionVariables.set('timestamp', timestamp);",
          "pm.collectionVariables.set('nonce', nonce);",
          "pm.collectionVariables.set('sign', CryptoJS.HmacSHA256(signString, secret).toString(CryptoJS.enc.Hex).toUpperCase());",
          "",
          "console.log('signed string: ' + signString);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared verdict. Every response is one of a small set of shapes.",
          "let body;",
          "try { body = pm.response.json(); } catch (e) { console.log('Not JSON: ' + pm.response.text().slice(0, 200)); return; }",
          "",
          "const verdicts = {",
          "  '10000': 'OK.',",
          "  '401': 'Authentication failed. The appId/secret is not accepted. An UNSIGNED request returns this too, so it is not specific to your signature. Check 0a and 0b.',",
          "  '600': 'Business error. Also what a bad signature returns - read msg to tell which.',",
          "  '502': 'Parameter error. The request reached the endpoint and was understood; something in the payload is wrong.',",
          "  '500': 'System error on their side. Not a signature problem: a bad signature returns 600 and a malformed request returns 502.',",
          "  '404': 'Endpoint not present on this environment.'",
          "};",
          "",
          "console.log('code ' + body.code + ' — ' + (verdicts[body.code] || body.msg));",
          "pm.test('code is 10000', function () { pm.expect(body.code).to.eql('10000'); });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "0a. Unsigned request (baseline)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('dataJson', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "console.log('Baseline: with NO credentials, Ascend answers ' + body.code + ' ' + body.msg);",
                  "console.log('If 0b returns the same thing, your credentials are being treated as absent.');",
                  "pm.test('baseline captured', function () { pm.expect(body.code).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/openApi/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openApi",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Sends nothing. Establishes what a rejected request looks like, so 0b can be compared against it."
          }
        },
        {
          "name": "0b. Signed with your credentials",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('dataJson', JSON.stringify({ idNumber: pm.collectionVariables.get('idNumber'), phone: pm.collectionVariables.get('phone') }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.code === '10000') { console.log('Credentials are good. Everything below is testable.'); }",
                  "else if (body.code === '401') { console.log('Same as the unsigned baseline: this appId/secret is not accepted. Nothing below will work until that is fixed.'); }",
                  "pm.test('credentials accepted', function () { pm.expect(body.code).to.eql('10000'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/openApi/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openApi",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\": \"{{appId}}\",\n  \"timestamp\": \"{{timestamp}}\",\n  \"nonce\": \"{{nonce}}\",\n  \"sign\": \"{{sign}}\",\n  \"data\": {\n    \"idNumber\": \"{{idNumber}}\",\n    \"phone\": \"{{phone}}\"\n  }\n}"
            },
            "description": "The decisive request. If this returns 401 the credentials are the problem and nothing else in this collection can be concluded from."
          }
        }
      ]
    },
    {
      "name": "1. Known-good calls",
      "item": [
        {
          "name": "1a. users — identify, New vs Reloan",
          "event": [
