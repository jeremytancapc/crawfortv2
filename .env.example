# Copy this file to .env.local for local development.
# Keep secret values in .env.local/.env.stg/.env.production only.

# Environment
NEXT_PUBLIC_APP_ENV=local

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Session cookie signing key — min 32 chars, keep secret
APPLY_SESSION_SECRET=change-me-to-a-random-32-char-string

AIRCONNECT_API_KEY=
# POST body includes cfh5Id (e.g. CFH5-XXXXXXXX), leadId, loanAmount, customerName, phoneNumber, appointmentDate, timeSlot
AIRCONNECT_APPOINTMENTS_URL=

# AirConnect eligibility check — checks if customer exists in Crawford/lender systems
AIRCONNECT_ELIGIBILITY_URL=https://airconnect.capcfintech.com/api/leads/eligibility
AIRCONNECT_ELIGIBILITY_API_KEY=

# AXS partner integration
AXS_PARTNER_API_KEY=
AXS_TOKEN_SECRET=change-me-to-a-random-32-char-string
