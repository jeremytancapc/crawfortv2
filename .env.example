# Copy this file to .env.local for local development.
# Keep secret values in .env.local/.env.stg/.env.production only.

# Environment
NEXT_PUBLIC_APP_ENV=local

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Session cookie signing key — min 32 chars, keep secret
APPLY_SESSION_SECRET=change-me-to-a-random-32-char-string

AIRCONNECT_API_KEY=
# POST body includes cfh5Id (e.g. CFH5-XXXXXXXX), leadId, loanAmount, customerName, phoneNumber, appointmentDate, timeSlot
AIRCONNECT_APPOINTMENTS_URL=

# AirConnect eligibility check — checks if customer exists in Crawford/lender systems
AIRCONNECT_ELIGIBILITY_URL=https://airconnect.capcfintech.com/api/leads/eligibility
AIRCONNECT_ELIGIBILITY_API_KEY=

# AXS partner integration
AXS_PARTNER_API_KEY=
AXS_TOKEN_SECRET=change-me-to-a-random-32-char-string

# ── Singpass / Myinfo (FAPI 2.0, Myinfo v5) ───────────────────────────────
# Run `bash scripts/setup-singpass.sh` to generate keys and fill these in.
# Unset or SINGPASS_ENABLED=false keeps the local simulation in lib/singpass-simulate.ts.
SINGPASS_ENABLED=false
# staging | production — picks the issuer (stg-id.singpass.gov.sg vs id.singpass.gov.sg)
SINGPASS_ENV=staging
# 32-character alphanumeric string from the Singpass Developer Portal
SINGPASS_CLIENT_ID=
# Must match the Redirect URL registered in the SDP character for character
SINGPASS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Space-delimited; must be a subset of the Allowed Scopes approved in the SDP
SINGPASS_SCOPES=openid uinfin name dob email mobileno regadd residentialstatus marital noahistory cpfcontributions
# Private JWKs (single-line JSON). The PUBLIC halves go in the SDP; these never leave the server.
SINGPASS_SIG_PRIVATE_JWK=
SINGPASS_ENC_PRIVATE_JWK=

# Postgres (Neon pooled endpoint in deployments, local instance in dev)
DATABASE_URL=

# Debug: lets /api/dev/myinfo-capture accept and display a Singpass payload.
# Returns unminimised personal data — leave false unless actively debugging.
MYINFO_CAPTURE_ENABLED=false
