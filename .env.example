# Canonical reference for every environment variable this app reads.
#
# Copy to .env.local for development. Never put a real secret in this file -
# it is the one .env that is committed.
#
# Per-environment starting points live beside it:
#   .env.local.example       local development
#   .env.stg.example         staging
#   .env.production.example  production
#
# scripts/check-env.mjs fails if the code reads a variable this file does not
# document. Run it after adding one.

# ── App ──────────────────────────────────────────────────────────────────

# Public origin of this deployment. Used to build absolute URLs for redirects,
# so it must match the host the browser actually reaches.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Signs the apply session cookie. Minimum 32 characters. Rotating it logs out
# every applicant mid-funnel, so rotate deliberately.
APPLY_SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────────────

# Postgres connection string.
#   deployments - Neon's POOLED endpoint (the host containing "-pooler").
#                 A Route Handler is short-lived and each cold start opens its
#                 own pool; without the pooler, traffic exhausts Postgres'
#                 connection limit.
#   local       - a plain local instance, no sslmode.
# Migrations: node scripts/db-migrate.mjs
DATABASE_URL=

# Direct (unpooled) endpoint. Neon's integration sets this automatically.
# Migrations use it in preference to DATABASE_URL: DDL through a transaction
# pooler is not something to stake a schema change on. Optional - without it
# migrations fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Which Neon branch the URLs above point at. Informational.
NEON_BRANCH=

# Connections per pool. Default 5. Raise only with the pooler in front.
DATABASE_POOL_MAX=5

# Database for the tests in lib/db/, which assert Postgres behaviour a fake
# cannot (the UNIQUE constraint guarding one Ascend order per applicant).
# Unset means those tests skip. Get one with:
#   bash scripts/db-test-server.sh start
TEST_DATABASE_URL=

# ── Ascend (lending system of record) ────────────────────────────────────
#
# Ascend owns the credit decision and the borrowable amount (ADR-0001). It
# stays off unless fully configured, so a deploy missing one variable behaves
# like one never meant to call Ascend rather than failing mid-journey.

ASCEND_ENABLED=false
# test https://api-mms.newtime.top
# uat  https://api-admin-uat-ascend.crawfort.com
# prod https://api-admin-ascend.crawfort.com
ASCEND_BASE_URL=
ASCEND_APP_ID=
ASCEND_APP_SECRET=

# ── AirConnect (CRM: leads and branch appointments) ──────────────────────
# Contract confirmed 2026-09-22. Both endpoints take the same auth (sent as
# the x-api-key header - AirConnect's side calls this value ASCEND_API_KEY,
# unrelated to this app's own ASCEND_APP_SECRET above) and the same body
# shape: customerName, phoneNumber, app ("dashboard" - lets AirConnect trace
# this app's requests separately), idNumber (optional). No cfh5Id/leadId/
# loanAmount - AirConnect's endpoints don't take them. See lib/airconnect/notify.ts.

AIRCONNECT_API_KEY=

# New lead: fires once, when Ascend opens an order for the applicant (or, on
# the AXS path with no Ascend order, once the engine decides). Does not wait
# for a booking. Their path: /api/ascend/leads/manualverify
AIRCONNECT_LEADS_URL=

# Appointment booked (apply/axs/aip `book` routes). Body adds
# appointmentDate, timeSlot. Their path: /api/appointments/ascend
AIRCONNECT_APPOINTMENTS_URL=

# ── AXS partner integration ──────────────────────────────────────────────

AXS_PARTNER_API_KEY=
AXS_TOKEN_SECRET=

# ── Singpass / MyInfo (FAPI 2.0) ─────────────────────────────────────────
#
# Run `bash scripts/setup-singpass.sh` to generate keys and fill these in.
# Unset, or SINGPASS_ENABLED=false, keeps the local simulation in
# lib/singpass-simulate.ts.

# The Lambda that owns the Singpass round trip. It authenticates the applicant,
# retrieves MyInfo, POSTs the payload to /api/auth/callback, and sends the
# browser to the URL that returns.
#
# UNSET MEANS SIMULATE: /api/auth fabricates a MyInfo payload locally and never
# contacts Singpass. There is deliberately no hardcoded default - the previous
# version fell back to the staging Lambda, so an unset variable in production
# would have sent real applicants to staging Singpass silently.
MYINFO_AUTH_URL=

SINGPASS_ENABLED=false

# staging | production. Picks the issuer:
#   staging    https://stg-id.singpass.gov.sg/fapi
#   production https://id.singpass.gov.sg/fapi
SINGPASS_ENV=staging

# 32-character alphanumeric string from the Developer Portal.
SINGPASS_CLIENT_ID=

# Must match the Redirect URL registered in the portal character for
# character, trailing slash included.
SINGPASS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Space-delimited, and a subset of the Allowed Scopes approved in the portal.
# These ten are what lib/myinfo.ts maps onto the form; anything more is data
# nothing reads, which the portal reviewers will ask you to justify.
SINGPASS_SCOPES=openid uinfin name dob email mobileno regadd residentialstatus marital noahistory cpfcontributions

# Private JWKs, single-line JSON, generated by scripts/singpass-keygen.mjs.
# The PUBLIC halves go in the Developer Portal; these never leave the server.
SINGPASS_SIG_PRIVATE_JWK=
SINGPASS_ENC_PRIVATE_JWK=

# ── Debug ────────────────────────────────────────────────────────────────

# Lets /api/dev/capture accept a payload and display it at
# /auth/callback-result. Returns unminimised personal data - full NRIC,
# address, CPF and NOA history - to anyone holding the link.
# Leave false. Switch on deliberately, switch off after.
# Where a Reloan Customer is sent to continue. Unset means the download button
# is not rendered at all and they are pointed at WhatsApp instead - a dead link
# to a store is worse than one working route to a person.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# ── Reading payslips ─────────────────────────────────────────────────────

# Reads the documents an applicant uploads and reports their monthly income,
# which becomes m1/m2/m3 on Ascend's /openApi/income/credit.
#
# Server-side only - never prefix this NEXT_PUBLIC_, which would ship the key
# to the browser.
#
# Unset means the step is not attempted and the applicant is asked to upload
# their payslips again, which is a dead end they cannot escape: no key, no
# reading, no figures, so they can never get past this step. Set it in every
# environment where someone will complete an application.
ANTHROPIC_API_KEY=

MYINFO_CAPTURE_ENABLED=false

# ── Applicant documents ───────────────────────────────────────────────────
# Payslips an applicant uploads. Ascend's /openApi/file/upload has answered
# 500 to every request shape tried, so documents are stored here and Ascend is
# given a link on our own domain instead of a raw S3 URL - which would expire,
# leaving a credit decision with no retrievable evidence behind it.
#
# The bucket blocks all public access. Nothing reads it but the server.
# Create it with: scripts/setup-documents-bucket.sh
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Signs the document links handed to Ascend, so a guessed URL fetches nothing.
DOCUMENTS_URL_SECRET=
