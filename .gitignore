# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Per-environment templates. Placeholders only - never real values.
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ascend API smoke tests — hold live appId/secret, never commit
scripts/ascend-test.mjs
scripts/ascend-users-check.mjs

# Singpass public JWKS — regenerate with scripts/singpass-keygen.mjs, do not commit
singpass-jwks.public.json
.neon

# Throwaway Postgres for database-backed tests
.tmp/

# Applicant documents — payslips carry NRIC, bank accounts and home addresses.
# Read them from wherever they already sit (scripts/read-payslips.mjs takes a
# path or an s3:// URI); never copy one into the repo. Force-add with `git add
# -f` only for a fixture you have confirmed holds no real person's details.
*.pdf
*.jpg
*.jpeg
*.png
!public/**
!docs/**
