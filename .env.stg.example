# Staging. Set these in the Vercel dashboard, scoped to Preview.
# See .env.example for what every variable means.
#
# Vercel bakes variables in at build time: after changing one you must
# redeploy, or the running deployment will not see it.

NEXT_PUBLIC_APP_BASE_URL=https://<your-staging-domain>
APPLY_SESSION_SECRET=<32+ random characters, not the production one>

# Neon POOLED endpoint - the host containing "-pooler".
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Direct endpoint, used by migrations in preference to the pooled URL.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
NEON_BRANCH=main

# Ascend's `test` environment. Credentials were accepted by test only;
# uat answered 401 when last smoke-tested.
ASCEND_ENABLED=false
ASCEND_BASE_URL=https://api-mms.newtime.top
ASCEND_APP_ID=
ASCEND_APP_SECRET=

AIRCONNECT_API_KEY=
AIRCONNECT_APPOINTMENTS_URL=
AIRCONNECT_ELIGIBILITY_URL=https://airconnect.capcfintech.com/api/leads/eligibility
AIRCONNECT_ELIGIBILITY_API_KEY=

AXS_PARTNER_API_KEY=
AXS_TOKEN_SECRET=

# Singpass staging. Log in with a test account created in the Developer
# Portal - staging has no real Singpass users.
# Staging Lambda (FAPI 2.0 / Myinfo v5).
MYINFO_AUTH_URL=https://<lambda-id>.execute-api.ap-southeast-1.amazonaws.com/stg/auth

SINGPASS_ENABLED=false
SINGPASS_ENV=staging
SINGPASS_CLIENT_ID=
SINGPASS_REDIRECT_URI=https://<your-staging-domain>/api/auth/callback
SINGPASS_SCOPES=openid uinfin name dob email mobileno regadd residentialstatus marital noahistory cpfcontributions
SINGPASS_SIG_PRIVATE_JWK=
SINGPASS_ENC_PRIVATE_JWK=

# Acceptable here because staging test accounts carry synthetic data.
# Switch back to false once you have seen what you need.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

MYINFO_CAPTURE_ENABLED=false
