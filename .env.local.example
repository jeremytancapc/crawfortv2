# Local development. Copy to .env.local and fill in the blanks.
# See .env.example for what every variable means.

NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
APPLY_SESSION_SECRET=local-dev-secret-at-least-32-characters

# A local Postgres, not Neon - no sslmode, no pooler.
#   createdb crawfort && node scripts/db-migrate.mjs
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/crawfort

# Set automatically when using Neon rather than a local instance.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Externals stay off locally: nothing here should reach a real lender,
# CRM or credit bureau from a laptop.
ASCEND_ENABLED=false
ASCEND_BASE_URL=
ASCEND_APP_ID=
ASCEND_APP_SECRET=

AIRCONNECT_API_KEY=
AIRCONNECT_APPOINTMENTS_URL=
AIRCONNECT_ELIGIBILITY_URL=
AIRCONNECT_ELIGIBILITY_API_KEY=

AXS_PARTNER_API_KEY=
AXS_TOKEN_SECRET=local-dev-secret-at-least-32-characters

# Off means the funnel uses the local simulation, which always resolves to
# approved. Switch on only when testing the real staging integration.
# Unset = simulate locally, which is usually what you want on a laptop.
MYINFO_AUTH_URL=

SINGPASS_ENABLED=false
SINGPASS_ENV=staging
SINGPASS_CLIENT_ID=
SINGPASS_REDIRECT_URI=http://localhost:3000/api/auth/callback
SINGPASS_SCOPES=openid uinfin name dob email mobileno regadd residentialstatus marital noahistory cpfcontributions
SINGPASS_SIG_PRIVATE_JWK=
SINGPASS_ENC_PRIVATE_JWK=

# Safe locally: the data is synthetic and the port is not public.
MYINFO_CAPTURE_ENABLED=true
