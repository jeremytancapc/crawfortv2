# Production. Set these in the Vercel dashboard, scoped to Production only.
# See .env.example for what every variable means.
#
# Every value here is distinct from staging. Sharing a secret across the two
# means a staging compromise is a production compromise.

NEXT_PUBLIC_APP_BASE_URL=https://<your-production-domain>
APPLY_SESSION_SECRET=<32+ random characters, unique to production>

# Neon POOLED endpoint, and a different project from staging - staging must
# never be able to read real applicant records.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

ASCEND_ENABLED=true
ASCEND_BASE_URL=https://api-admin-ascend.crawfort.com
ASCEND_APP_ID=
ASCEND_APP_SECRET=

AIRCONNECT_API_KEY=
AIRCONNECT_APPOINTMENTS_URL=
AIRCONNECT_ELIGIBILITY_URL=https://airconnect.capcfintech.com/api/leads/eligibility
AIRCONNECT_ELIGIBILITY_API_KEY=

AXS_PARTNER_API_KEY=
AXS_TOKEN_SECRET=

# Production Singpass: real people, real NRIC, real CPF and NOA history.
# Keys must be a different pair from staging.
SINGPASS_ENABLED=true
SINGPASS_ENV=production
SINGPASS_CLIENT_ID=
SINGPASS_REDIRECT_URI=https://<your-production-domain>/api/auth/callback
SINGPASS_SCOPES=openid uinfin name dob email mobileno regadd residentialstatus marital noahistory cpfcontributions
SINGPASS_SIG_PRIVATE_JWK=
SINGPASS_ENC_PRIVATE_JWK=

# MUST stay false. It exposes a real person's full NRIC, address, CPF and NOA
# history to anyone holding the link. There is no production reason to set it.
MYINFO_CAPTURE_ENABLED=false
