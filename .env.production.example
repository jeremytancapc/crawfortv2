# Production (get.crawfort.com). Set these in the Vercel dashboard, scoped to
# Production only. See .env.example for what every variable means.
#
# Every secret here is distinct from staging. Sharing one across the two means a
# staging compromise is a production compromise.
#
# Three groups, in this order:
#   1. FILL IN       16 values only you can supply.
#   2. ALREADY SET    9 values that are correct as written. Copy them across.
#   3. NOT USED      9 names the running app never reads (kept so that
#                    npm run check:env stays in step with .env.example).
#                    Leave them out of Vercel.

# ══ 1. FILL IN ═══════════════════════════════════════════════════════════

APPLY_SESSION_SECRET=<32+ random characters, unique to production>

# Neon POOLED endpoint, and a different project from staging - staging must
# never be able to read real applicant records.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Direct endpoint, used by migrations in preference to the pooled URL.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

ASCEND_APP_ID=
ASCEND_APP_SECRET=

AIRCONNECT_API_KEY=
AIRCONNECT_APPOINTMENTS_URL=
AIRCONNECT_LEADS_URL=

AXS_PARTNER_API_KEY=
AXS_TOKEN_SECRET=

ANTHROPIC_API_KEY=

# Payslips and statements an applicant uploads are stored in a private S3
# bucket (create it with scripts/setup-documents-bucket.sh); Ascend is given a
# signed link on our own domain. All must be set or uploads fail.
DOCUMENTS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DOCUMENTS_URL_SECRET=

# Guards the two daily jobs in vercel.json. Vercel sends it automatically.
CRON_SECRET=

# ══ 2. ALREADY SET ═══════════════════════════════════════════════════════

NEXT_PUBLIC_APP_BASE_URL=https://get.crawfort.com

ASCEND_ENABLED=true
ASCEND_BASE_URL=https://api-admin-ascend.crawfort.com

# Production Singpass Lambda. Must NOT be a /stg/ endpoint. The Lambda owns the
# whole Singpass round trip, and its own settings must send the MyInfo payload to
# https://get.crawfort.com/api/auth/callback.
MYINFO_AUTH_URL=https://lss57v8zd2.execute-api.ap-southeast-1.amazonaws.com/prod/auth

# Read by the app only to turn off the staging-only test banks.
SINGPASS_ENV=production

DOCUMENTS_S3_REGION=ap-southeast-1

# MUST stay false. They expose a real person's full NRIC, address, CPF and NOA
# history, or let anyone with the link rewrite it. There is no production reason
# to turn either on.
MYINFO_CAPTURE_ENABLED=false
MYINFO_EDITOR_ENABLED=false

# MUST stay empty. Extra bank names accepted for tests; ignored on production.
TEST_RECOGNISED_BANKS=

# ══ 3. NOT USED by the running app - leave out of Vercel ═════════════════
# Singpass is handled by the Lambda above, which holds its own client id, keys,
# redirect and scopes. These are only written by scripts/setup-singpass.sh for
# local use.

SINGPASS_ENABLED=
SINGPASS_CLIENT_ID=
SINGPASS_REDIRECT_URI=
SINGPASS_SCOPES=
SINGPASS_SIG_PRIVATE_JWK=
SINGPASS_ENC_PRIVATE_JWK=

NEON_BRANCH=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
